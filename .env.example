# Paid OpenAI access. Required only when OpenAI-backed operations are used.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_PDF_MODEL=gpt-4o-mini
OPENAI_PDF_DETAIL=low
OPENAI_PDF_MAX_MB=49
OPENAI_PDF_RETRIES=2

# Local Ollama service. Used for low-cost preprocessing and query normalization.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_METADATA_MODEL=qwen3:4b
OLLAMA_QUERY_MODEL=qwen3:4b
OLLAMA_CLASSIFIER_MODEL=gemma3:4b
OLLAMA_CODE_MODEL=qwen2.5-coder:7b

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
ACADEMIC_ONLY=true
ACADEMIC_ALLOWED_DOMAINS=
REQUIRE_ACADEMIC_CLASSIFICATION=true
MAX_PDF_SIZE_MB=100
SCRAPE_PDF_LIMIT=100
SCRAPE_PROCESS_LIMIT=10
SCRAPE_DOWNLOAD_WORKERS=4
SCRAPE_PROCESSING_WORKERS=1
SCRAPE_ALLOW_SUBDOMAINS=false
SCRAPE_DELAY_SECONDS=0.25
SCRAPE_TIMEOUT_SECONDS=20
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_RETRIES=2
OLLAMA_COMBINED_ANALYSIS=true
MAX_CONTEXT_CHUNKS=8
OPENAI_REQUEST_TIMEOUT_SECONDS=60

